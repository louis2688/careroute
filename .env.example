# Supabase project (Project Settings > API Keys). The secret key stays on the server; never expose it to the browser.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=

# Shared password for /admin (browser password prompt, any username).
ADMIN_PASSWORD=change-me
# Signs the driver and facility session cookies. Optional: falls back to ADMIN_PASSWORD.
AUTH_SECRET=

# Passenger notifications. Leave blank and messages print to the server log instead of sending.
RESEND_API_KEY=
EMAIL_FROM=CareRoute <onboarding@resend.dev>
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
